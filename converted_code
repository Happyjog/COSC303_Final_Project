#Room creation:

func create_room() -> int:
	var room_id: int = rooms.size()

	rooms[room_id] = {
		"north": -1,
		"south": -1,
		"east": -1,
		"west": -1,
		"is_boss_room": false,
		"item": "",
		"occupant": null
	}

	return room_id

